// ═══ My Services (Mobile - Adaptado de Web) ══════════════════════

:host {
  display: flex;
  flex-direction: column;
  height: 100%;
}

ion-content {
  --background: var(--bapp-bg-page);
}

/* ══ TOPBAR ════════════════════════════════════════════════════ */
.ms-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--bapp-space-4);
  padding: calc(var(--bapp-space-6) + env(safe-area-inset-top, 0px)) var(--bapp-space-4) var(--bapp-space-6);
  border-bottom: 1px solid var(--bapp-border);
  background: var(--bapp-bg-card);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.ms-topbar-left {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
  min-width: 0;
}

.ms-topbar-actions {
  display: inline-flex;
  align-items: center;
  gap: var(--bapp-space-2);
  flex-wrap: wrap;
}

.ms-topbar-eyebrow {
  font-size: 10px;
  font-weight: var(--bapp-font-extrabold);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--bapp-text-tertiary);
}

.ms-topbar-title {
  font-size: 22px;
  font-weight: var(--bapp-font-extrabold);
  letter-spacing: -0.5px;
  color: var(--bapp-text-primary);
  margin: 0;
  
  @media (max-width: 380px) { font-size: 18px; }
}

/* ── Botones del topbar ──────────────────────────────────────── */
.ms-btn-add {
  --background: var(--bapp-color-primary);
  --color: #000;
  --border-radius: var(--bapp-radius-md);
  --padding-start: var(--bapp-space-4);
  --padding-end: var(--bapp-space-4);
  font-weight: var(--bapp-font-extrabold);
  font-size: 12px;
  text-transform: none;
  --box-shadow: 0 4px 16px rgba(253, 215, 53, 0.18);
  
  ion-icon {
    font-size: 16px;
  }
  
  &.ms-btn-add--cta {
    --padding-start: var(--bapp-space-6);
    --padding-end: var(--bapp-space-6);
    font-size: 13px;
  }
}

.ms-btn-upgrade {
  --background: rgba(253, 215, 53, 0.08);
  --color: var(--bapp-color-primary);
  --border-width: 1px;
  --border-style: solid;
  --border-color: rgba(253, 215, 53, 0.35);
  --border-radius: var(--bapp-radius-md);
  --padding-start: var(--bapp-space-3);
  --padding-end: var(--bapp-space-3);
  font-weight: var(--bapp-font-bold);
  font-size: 11px;
  text-transform: none;
}

/* ══ BODY ══════════════════════════════════════════════════════ */
.ms-body {
  padding: var(--bapp-space-6) var(--bapp-space-4);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--bapp-space-6);
  animation: ms-fade-in 0.35s ease-out;
}

@keyframes ms-fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ══ SUMMARY BAR ═══════════════════════════════════════════════ */
.ms-summary-bar {
  display: flex;
  align-items: center;
  gap: var(--bapp-space-4);
  flex-wrap: wrap;
}

.ms-summary-count {
  font-size: var(--bapp-text-sm);
  font-weight: var(--bapp-font-bold);
  color: var(--bapp-text-primary);
}

.ms-summary-chips {
  display: flex;
  gap: var(--bapp-space-2);
  flex-wrap: wrap;
}

.ms-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: var(--bapp-font-bold);
  padding: 4px 12px;
  border-radius: 9999px;
  border: 1px solid;
  
  &.ms-chip--approved {
    background: rgba(52, 211, 153, 0.08);
    border-color: rgba(52, 211, 153, 0.25);
    color: #34D399;
    .ms-chip-dot { background: #34D399; }
  }
  
  &.ms-chip--pending {
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.25);
    color: #FBBF24;
    .ms-chip-dot { background: #FBBF24; }
  }
  
  &.ms-chip--rejected {
    background: rgba(248, 113, 113, 0.08);
    border-color: rgba(248, 113, 113, 0.25);
    color: #F87171;
    .ms-chip-dot { background: #F87171; }
  }
}

.ms-chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ══ SERVICE GRID ══════════════════════════════════════════════ */
.ms-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--bapp-space-4);
  
  @media (min-width: 768px) {
    grid-template-columns: repeat(2, 1fr);
  }
  
  @media (min-width: 1024px) {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ══ SERVICE CARD ══════════════════════════════════════════════ */
.ms-service-card {
  background: var(--bapp-bg-card);
  border: 1px solid var(--bapp-border);
  border-radius: var(--bapp-radius-xl);
  padding: var(--bapp-space-5);
  display: flex;
  flex-direction: column;
  gap: var(--bapp-space-4);
  position: relative;
  transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  overflow: hidden;
  
  /* Glow sutil en active */
  &::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 0%, rgba(253, 215, 53, 0.03), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  
  &:active {
    border-color: rgba(253, 215, 53, 0.18);
    transform: translateY(-3px);
    box-shadow: var(--bapp-shadow-card);
    
    &::before { opacity: 1; }
    
    .ms-card-icon {
      background: rgba(253, 215, 53, 0.1);
      border-color: rgba(253, 215, 53, 0.2);
      
      ion-icon { color: var(--bapp-color-primary); }
    }
  }
  
  &.ms-service-card--inactive {
    opacity: 0.55;
    
    .ms-card-name { color: var(--bapp-text-secondary); }
  }
}

/* ── Card header ──────────────────────────────────────────────── */
.ms-card-header {
  display: flex;
  align-items: flex-start;
  gap: var(--bapp-space-4);
}

.ms-card-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--bapp-radius-md);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--bapp-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.25s ease, border-color 0.25s ease;
  
  ion-icon { 
    font-size: 20px; 
    color: var(--bapp-text-secondary); 
    transition: color 0.25s ease; 
  }
}

.ms-card-name-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.ms-card-name {
  font-size: 15px;
  font-weight: var(--bapp-font-bold);
  color: var(--bapp-text-primary);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ms-card-category {
  font-size: 11px;
  font-weight: var(--bapp-font-semibold);
  color: var(--bapp-color-primary);
  opacity: 0.75;
}

.ms-card-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5px;
  flex-shrink: 0;
}

/* ── Status badges ────────────────────────────────────────────── */
.ms-status-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: var(--bapp-font-extrabold);
  padding: 3px 10px;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  white-space: nowrap;
  
  &.ms-status-badge--approved {
    background: rgba(52, 211, 153, 0.1);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.22);
  }
  
  &.ms-status-badge--pending {
    background: rgba(251, 191, 36, 0.1);
    color: #FBBF24;
    border: 1px solid rgba(251, 191, 36, 0.22);
  }
  
  &.ms-status-badge--rejected {
    background: rgba(248, 113, 113, 0.08);
    color: #F87171;
    border: 1px solid rgba(248, 113, 113, 0.2);
  }
  
  &.ms-status-badge--inactive {
    background: rgba(148, 163, 184, 0.07);
    color: #94A3B8;
    border: 1px solid rgba(148, 163, 184, 0.15);
  }
}

/* ── Descripción ──────────────────────────────────────────────── */
.ms-card-desc {
  font-size: var(--bapp-text-sm);
  line-height: 1.6;
  color: var(--bapp-text-secondary);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Metadata ─────────────────────────────────────────────────── */
.ms-card-meta {
  display: flex;
  align-items: center;
  gap: var(--bapp-space-4);
  flex-wrap: wrap;
}

.ms-meta-rate {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: var(--bapp-text-sm);
  font-weight: var(--bapp-font-extrabold);
  color: var(--bapp-color-primary);
  
  ion-icon { 
    font-size: 14px; 
    flex-shrink: 0; 
  }
}

.ms-meta-address {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: var(--bapp-font-medium);
  color: var(--bapp-text-secondary);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200px;
  
  ion-icon { 
    font-size: 12px; 
    flex-shrink: 0; 
  }
}

/* ── Divider ──────────────────────────────────────────────────── */
.ms-card-divider {
  height: 1px;
  background: var(--bapp-border);
  margin: 0 calc(var(--bapp-space-5) * -1);
}

/* ── Acciones ─────────────────────────────────────────────────── */
.ms-card-actions {
  display: flex;
  gap: var(--bapp-space-2);
  align-items: center;
}

.ms-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 16px;
  border-radius: var(--bapp-radius-md);
  font-size: 12px;
  font-weight: var(--bapp-font-bold);
  font-family: inherit;
  cursor: pointer;
  background: transparent;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  border: 1px solid;
  
  ion-icon { 
    font-size: 13px; 
    flex-shrink: 0; 
  }
  
  &:active { transform: scale(0.96); }
  
  &.ms-action-btn--edit {
    background: rgba(96, 165, 250, 0.08);
    border-color: rgba(96, 165, 250, 0.2);
    color: #60A5FA;
    
    &:active { 
      background: rgba(96, 165, 250, 0.15); 
      border-color: rgba(96, 165, 250, 0.35); 
    }
  }
  
  &.ms-action-btn--delete {
    background: rgba(248, 113, 113, 0.07);
    border-color: rgba(248, 113, 113, 0.18);
    color: #F87171;
    flex: 1;
    justify-content: center;
    
    &:active { 
      background: rgba(248, 113, 113, 0.14); 
      border-color: rgba(248, 113, 113, 0.3); 
    }
  }
}

.ms-action-toggle {
  --background: rgba(148, 163, 184, 0.15);
  --background-checked: var(--bapp-color-primary);
  --handle-background: #fff;
  --handle-background-checked: #000;
  margin-left: auto;
}

/* ══ EMPTY / ERROR STATE ═══════════════════════════════════════ */
.ms-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--bapp-space-4);
  padding: var(--bapp-space-12) var(--bapp-space-4);
  text-align: center;
  animation: ms-fade-in 0.35s ease-out;
}

.ms-empty-icon {
  width: 72px;
  height: 72px;
  border-radius: var(--bapp-radius-xl);
  background: rgba(253, 215, 53, 0.06);
  border: 1px solid rgba(253, 215, 53, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  
  ion-icon { 
    font-size: 32px; 
    color: rgba(253, 215, 53, 0.4); 
  }
  
  &.ms-empty-icon--error {
    background: rgba(248, 113, 113, 0.06);
    border-color: rgba(248, 113, 113, 0.15);
    
    ion-icon { color: rgba(248, 113, 113, 0.5); }
  }
}

.ms-empty-title {
  font-size: var(--bapp-text-xl);
  font-weight: var(--bapp-font-extrabold);
  color: var(--bapp-text-primary);
  margin: 0;
}

.ms-empty-desc {
  font-size: var(--bapp-text-sm);
  color: var(--bapp-text-secondary);
  margin: 0;
  max-width: 380px;
  line-height: 1.6;
}

.ms-btn-retry {
  --background: rgba(255, 255, 255, 0.05);
  --color: var(--bapp-text-primary);
  --border-width: 1px;
  --border-style: solid;
  --border-color: var(--bapp-border);
  --border-radius: var(--bapp-radius-md);
  font-weight: var(--bapp-font-bold);
  font-size: var(--bapp-text-sm);
  text-transform: none;
  
  ion-icon {
    font-size: 15px;
  }
}

/* ══ SKELETON ══════════════════════════════════════════════════ */
.ms-sk-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--bapp-space-4);
  
  @media (min-width: 768px) {
    grid-template-columns: repeat(2, 1fr);
  }
  
  @media (min-width: 1024px) {
    grid-template-columns: repeat(3, 1fr);
  }
}

.ms-sk-card {
  background: var(--bapp-bg-card);
  border: 1px solid var(--bapp-border);
  border-radius: var(--bapp-radius-xl);
  padding: var(--bapp-space-5);
  display: flex;
  flex-direction: column;
  gap: var(--bapp-space-4);
}

.ms-sk-card-header {
  display: flex;
  align-items: center;
  gap: var(--bapp-space-4);
}

.ms-sk-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ms-sk-footer {
  display: flex;
  gap: 10px;
}

.ms-sk {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  animation: ms-pulse 1.8s ease-in-out infinite;
  
  &.ms-sk--icon    { width: 44px; height: 44px; border-radius: var(--bapp-radius-md); flex-shrink: 0; }
  &.ms-sk--title   { height: 15px; width: 55%; }
  &.ms-sk--sub     { height: 11px; width: 35%; }
  &.ms-sk--desc    { height: 12px; width: 90%; }
  &.ms-sk--desc-short { width: 65%; }
  &.ms-sk--chip    { height: 22px; width: 70px; border-radius: 9999px; }
}

@keyframes ms-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}
