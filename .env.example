# ============================================================
# FRONTEND — Variables de Entorno (EJEMPLO)
# Copiar como .env y completar con valores reales:
#   cp .env.example .env
# Ejecutar antes del build: npm run set-env
# ============================================================

# API Backend
API_URL=https://backend-bapp.onrender.com/api/v1

# Geoapify — https://www.geoapify.com/ (mapas estáticos, geocoding)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# OAuth — Google Cloud Console: https://console.cloud.google.com/
# Habilitar "Google Sign-In for Android/iOS" + OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OAuth — Meta Developers: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id_here

# RevenueCat — https://app.revenuecat.com/ (API key pública "Apple App Store" del proyecto)
REVENUECAT_API_KEY_IOS=your_revenuecat_ios_public_api_key_here
