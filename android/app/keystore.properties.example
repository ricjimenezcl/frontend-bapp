# Copia este archivo como "keystore.properties" (sin .example) en esta misma carpeta
# y completa los valores reales. NUNCA subas keystore.properties ni el archivo .jks/.keystore
# al repositorio (ya están ignorados en .gitignore).
#
# storeFile: ruta relativa al .jks/.keystore generado (puede vivir en esta misma carpeta)
# storePassword / keyPassword: las contraseñas que definiste al generar el keystore con keytool
# keyAlias: el alias que definiste al generar el keystore

storeFile=release-key.jks
storePassword=CAMBIA_ESTA_PASSWORD
keyAlias=bapp
keyPassword=CAMBIA_ESTA_PASSWORD
